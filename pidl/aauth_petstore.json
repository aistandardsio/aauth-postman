            ]
          },
          "example": {
            "source": "draft-11 §6",
            "kind": "derived",
            "request": {
              "method": "GET",
              "url": "https://resource.example/v2/store/order/1",
              "headers": [
                {
                  "name": "Signature-Input",
                  "value": "sig=(\"@method\" \"@authority\" \"@path\" \"signature-key\");created=1730217740"
                },
                {
                  "name": "Signature",
                  "value": "sig=:SIGNATURE-PLACEHOLDER:"
                },
                {
                  "name": "Signature-Key",
                  "value": "sig=jwt;jwt=\"eyJhbGciOiJFZDI1NTE5IiwidHlwIjoiYWEtYXV0aCtqd3QiLCJraWQiOiJwcy1rZXktMSJ9.eyJpc3MiOi…\""
                }
