            "tokens": [
              {
                "token": "auth_token",
                "label": "response body",
                "header": {
                  "alg": "Ed25519",
                  "typ": "aa-auth+jwt",
                  "kid": "ps-key-1"
                },
                "payload": {
                  "iss": "https://ps.example",
                  "dwk": "aauth-person.json",
                  "aud": "https://resource.example",
                  "ps": "https://ps.example",
                  "sub": "8f14e45fceea167a5a36dedd4bea2543",
                  "scope": "write:orders",
                  "cnf": {
                    "jwk": {
                      "kty": "OKP",
                      "crv": "Ed25519",
                      "x": "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo",
                      "alg": "Ed25519"
                    }
                  },
                  "jti": "auth-4c2d71",
                  "iat": 1730217720,
                  "exp": 1730221200
                }
              }
            ],
            "note": "The PS issues the auth token itself (dwk aauth-person.json). Its exp does not exceed the person token's, so expires_in is shorter than an hour."
          }
